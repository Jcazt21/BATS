{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": false,
      "dev": true
    }
  },
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "bats_core/**",
      "excludeFiles": "{web/**,tests/**,**/__pycache__/**,bats_core/bot/**,bats_core/.pokeapi_cache/**,bats_core/{cli,metrics,report,pokeapi,bans,backfill,mvp}.py,bats_core/validate_team.js,bats_core/db/seed.sql,bats_core/db/roles.sql}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/refresh-views", "schedule": "0 6 * * *" }
  ]
}
