{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": false
  },
  "installCommand": "npm ci && cd web && npm ci",
  "regions": ["iad1"],
  "fluid": true,
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "bats_core/**",
      "excludeFiles": "{{motor,node_modules,web,tests}/**,**/__pycache__/**,package*.json,tsconfig.json,bats_core/{bot/**,.pokeapi_cache/**,validate_team.js,db/{seed,roles}.sql,{cli,metrics,report,pokeapi,bans,backfill,mvp}.py}}"
    },
    "api/motor.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/motor/(.*)", "destination": "/api/motor" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/refresh-views", "schedule": "0 6 * * *" }
  ]
}
