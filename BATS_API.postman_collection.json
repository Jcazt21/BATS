{
  "info": {
    "name": "BATS API",
    "description": "Battle Analyzing & Tracking System — colección completa de endpoints, organizada por módulo de front.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8001",  "type": "string" },
    { "key": "token",    "value": "",                       "type": "string",
      "description": "Se llena automáticamente al ejecutar POST /api/admin/login" }
  ],
  "item": [

    {
      "name": "🔐 Auth (Login)",
      "description": "Autenticación del panel admin.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "  console.log('Token guardado en variable de colección');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"tu_password_admin\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/login", "host": ["{{base_url}}"], "path": ["api","admin","login"] }
          }
        }
      ]
    },

    {
      "name": "🗳️ Ban (votación pública)",
      "description": "Módulo público de votación de bans — BanPage.",
      "item": [
        {
          "name": "Check User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jamblet\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/ban/check-user", "host": ["{{base_url}}"], "path": ["api","ban","check-user"] }
          }
        },
        {
          "name": "Submit Ban Vote",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jamblet\",\n  \"pokemon_name\": \"Snorlax\",\n  \"pokemon_types\": \"Normal\",\n  \"sprite_url\": \"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/143.png\",\n  \"national_dex\": 143\n}"
            },
            "url": { "raw": "{{base_url}}/api/ban/submit", "host": ["{{base_url}}"], "path": ["api","ban","submit"] }
          }
        },
        {
          "name": "Ban Ranking",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/ban/ranking", "host": ["{{base_url}}"], "path": ["api","ban","ranking"] }
          }
